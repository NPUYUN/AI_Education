#!/bin/bash

echo "======================================"
echo " Running Git Pre-Commit Hook"
echo "======================================"

echo "Running Ktlint (Auto-formatting)..."
./gradlew ktlintFormat
KTLINT_STATUS=$?

echo "Running Detekt (Code quality analysis)..."
./gradlew detekt
DETEKT_STATUS=$?

if [ $DETEKT_STATUS -ne 0 ] || [ $KTLINT_STATUS -ne 0 ]; then
  echo "=========================================================="
  echo " ⚠️  Code quality checks found some issues or formatting was applied!"
  echo "     Commit is ALLOWED to proceed to avoid blocking your workflow."
  echo "     Please review the Gradle reports above when possible."
  echo "=========================================================="
else
  echo "=========================================================="
  echo " ✅ All checks passed! Proceeding with commit..."
  echo "=========================================================="
fi

# Always exit 0 to not block the commit, preventing false positives from ruining workflows
exit 0
