#!/bin/bash

echo "======================================"
echo " Running Git Pre-Commit Hook"
echo "======================================"

echo "Running Detekt..."
./gradlew detekt
DETEKT_STATUS=$?

echo "Running Ktlint..."
./gradlew ktlintCheck
KTLINT_STATUS=$?

if [ $DETEKT_STATUS -ne 0 ] || [ $KTLINT_STATUS -ne 0 ]; then
  echo "=========================================================="
  echo " Code quality checks failed! Commit aborted."
  echo " Please fix the issues and try again."
  echo " You can use './gradlew ktlintFormat' to auto-format code."
  echo "=========================================================="
  exit 1
fi

echo "All checks passed! Proceeding with commit..."
exit 0
